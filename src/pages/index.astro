---
import Project from "@/components/Project.astro";
import { projects } from "@/data";
import Layout from "@/layouts/Layout.astro";
import { type project } from "@/lib/types";
import { Linkedin, Github } from "@lucide/astro";

---

<Layout title="João Oliveira">
    <main class="py-14">
        <section id="hero" class="">
            <div class="mx-auto max-w-7xl
                        px-6 pb-14 grid grid-cols-2 items-center gap-x-8 gap-y-14">
                <div>
                    <h1 class="font-accent text-6xl font-bold tracking-wide text-balance text-gray-900">
                        João Oliveira
                    </h1>
                    <p class="mt-4 text-xl font-medium text-pretty text-gray-500">
                        Software Developer exploring backend, full-stack, and wherever code takes me.
                    </p>
                    <ul class="mt-10 text-md font-medium text-pretty flex gap-4">
                        <li class="bg-blue-500 rounded-sm shadow-lg/20 hover:bg-amber-500">
                            <a href="https://www.linkedin.com/in/joao-oliveira-304134226/" target="_blank"
                               class="flex gap-3 items-center px-3 py-1 text-white tracking-wide">
                                <Linkedin fill="white" stroke-width={1} size={16} color="white" />
                                LinkedIn
                            </a>
                        </li>
                        <li class="bg-zinc-700 rounded-sm shadow-lg/20 hover:bg-amber-500">
                            <a href="https://github.com/joao-pmoliveira" target="_blank"
                               class="flex gap-3 items-center px-3 py-1 text-white tracking-wide">
                                <Github fill="white" stroke-width={0} size={16} color="white" />
                                GitHub
                            </a>
                        </li>
                    </ul>
                </div>
            </div> 
        </section>

        <section id="projects">
            <div class="mx-auto max-w-7xl px-6 py-12">
                <h1 class="text-4xl mb-3 font-semibold text-gray-900">
                    Featured Projects
                </h1>
                <div>
                    { projects.map(p => <Project project={p} />) }
                </div>
            </div>
        </section>

        <section id="experience">
            <div class="mx-auto max-w-7xl px-6 py-12">
                <h1 class="text-4xl mb-5 font-semibold text-gray-900">
                    Work & Education
                </h1>

                <div class="mb-6">
                    <h2 class="text-xl font-semibold mb-1">Intern - Firmware Team</h2>
                    <p class="text-lg font-light mb-2">Bosch, Aveiro, Portugal (02/2024 - 06/2024)</p>
                    <ul class="space-y-1 max-w-[75ch] list-disc ml-4 *:text-pretty *:leading-7">
                        <li>Built an automatic testing system for Modbus protocol using PyModbus and Robot Framework, enhancing testing efficiency and accuracy.</li>
                        <li>Enabled dynamic simulation of Modbus units without interrupting live connections.</li>
                        <li>Contributed to Jenkins-based CI/CD and improved test automation, leading to faster deployment cycles and reduced manual errors.</li>
                    </ul>
                </div>

                <div class="mb-6">
                    <h2 class="text-xl font-semibold mb-1">Bachelor's Degree in Information Technologies</h2>
                    <p class="text-ls font-light mb-2">ESTGA - Universidade de Aveiro, Portugal (09/2021 - 07/2024)</p>
                    <ul class="max-w-[75ch] list-disc ml-4 *:text-pretty *:leading-7">
                        <li><span class="font-semibold">Relevant Coursework:</span> Compilers, Artificial Intelligence, Database Systems, Web Development, Software Engineering,
                            Test-Driven Development, Unit Testing, Data Structures, Threads, UI/UX, Project Management.</li>
                        <li>Completed a 4-month internship at Bosch Portugal as part of the curriculum. Graded 19/20.</li>
                    </ul>
                </div>
            </div>
        </section>
    </main>
</Layout>
